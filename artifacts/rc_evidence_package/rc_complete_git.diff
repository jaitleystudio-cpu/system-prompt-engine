+    """
+    STATIC_SCHEMA_INVARIANT = "STATIC_SCHEMA_INVARIANT"
+    HOST_PERMISSION_AND_EGRESS_INVARIANT = "HOST_PERMISSION_AND_EGRESS_INVARIANT"
+    MODEL_AND_TOOL_BEHAVIOR_DEPENDENT = "MODEL_AND_TOOL_BEHAVIOR_DEPENDENT"
+
+
