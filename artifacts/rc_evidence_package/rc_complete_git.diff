+    DETERMINISTIC_VERIFIER = "DETERMINISTIC_VERIFIER"
+    SYNTHETIC_FIXTURE = "SYNTHETIC_FIXTURE"
+    CALLER_DECLARED = "CALLER_DECLARED"
+    AGENT_SELF_REPORT = "AGENT_SELF_REPORT"
