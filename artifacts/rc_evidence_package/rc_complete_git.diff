+export interface PaymentWebhookEvent {
+  eventId: string;
+  eventNonce?: string;
+  eventType:
+    | "payment.succeeded"
+    | "subscription.past_due"
+    | "subscription.canceled"
+    | "subscription.expired"
+    | "payment.refunded"
