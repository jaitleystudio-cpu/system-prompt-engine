{
  "suite_id": "spe.bench.corpus-v1",
  "version": "1.0.0",
  "description": "Scientific 3-split benchmark corpus across 15 domains for paired AI instruction assurance evaluation.",
  "tasks": [
    {
      "task_id": "task-dev-01",
      "domain": "STRUCTURED_EXTRACTION",
      "split": "DEV",
      "prompt_input": "Extract user transaction records: User Alice paid 42.50 USD on 2026-10-01.",
      "oracle_type": "SCHEMA",
      "target_schema": {
        "type": "object",
        "required": ["user_id", "transaction_amount", "currency"]
      }
    },
    {
      "task_id": "task-dev-02",
      "domain": "CODING",
      "split": "DEV",
      "prompt_input": "Implement a Python function to compute SHA-256 digest of a string.",
      "oracle_type": "PROGRAMMATIC",
      "required_substring": "hashlib.sha256"
    },
    {
      "task_id": "task-dev-03",
      "domain": "RAG_GROUNDING",
      "split": "DEV",
      "prompt_input": "According to handbook excerpt section 2.1, what is the maximum sick leave days?",
      "oracle_type": "PROGRAMMATIC",
      "required_substring": "section 2.1"
    },
    {
