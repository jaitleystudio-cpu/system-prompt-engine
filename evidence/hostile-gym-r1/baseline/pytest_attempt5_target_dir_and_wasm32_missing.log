                            "kind": "positive",
                            "id": src["fixture_id"],
                            "py": py.get("status"),
                            "rs": rs.get("status"),
                            "wasm": wasm.get("status"),
                            "runtime": wasm.get("runtime"),
                            "py_rs": compare_protected(py, rs),
                            "rs_wasm": compare_protected(rs, wasm),
                        }
                    )
                records.append({"i": i, "kind": "positive", "ok": ok})
