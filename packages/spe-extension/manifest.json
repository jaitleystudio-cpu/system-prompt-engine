{
  "manifest_version": 3,
  "name": "SPE × Awesome Codex Pet (316 Pixel Pets Along Your Typing + Auto AI Cursor)",
  "short_name": "SPE Codex Pet",
  "version": "2.0.0",
  "description": "316 real pixel-art Codex Pets that walk along your typing caret + Autonomous Moving AI Cursor for ChatGPT, Claude, Gemini, Gmail & any website.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SPE × Awesome Codex Pet",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
