{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spe.local/schemas/website_spec.v1.schema.json",
  "title": "WebsiteSpec",
  "description": "Versioned static-site spec. The compiler emits HTML and CSS only. No network, hosting, account, or telemetry fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "title", "pages"],
  "properties": {
    "spec_version": { "type": "string", "const": "website-spec/1" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "language": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Za-z0-9]{2,8})?$" },
    "summary": { "type": "string", "maxLength": 4000 },
    "theme": { "type": "string", "enum": ["dark", "light"] },
    "emitter": { "type": "string", "const": "static-html-css" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibility": { "type": "string", "enum": ["private", "public"] }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title", "sections"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.html$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "heading"],
      "properties": {
        "kind": { "type": "string", "enum": ["hero", "prose", "list", "cta"] },
        "heading": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "maxLength": 4000 },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "cta_label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "cta_href": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
