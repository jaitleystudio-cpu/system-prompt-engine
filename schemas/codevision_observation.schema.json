{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spe.local/schemas/codevision_observation.schema.json",
  "title": "CodevisionScreenshotObservation",
  "description": "Structured observation of a screenshot. Image bytes and fidelity scores are outside this contract. Visual fidelity is not claimed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "source_kind", "canvas", "nodes"],
  "properties": {
    "schema_version": { "const": "spe.codevision.observation.v1" },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
    },
    "source_kind": { "const": "screenshot_observation" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fill_hex", "border_hex", "radius_px", "font_size_px", "font_weight"],
      "properties": {
        "fill_hex": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
          ]
        },
        "border_hex": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
          ]
        },
        "radius_px": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        },
        "font_size_px": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
        },
        "font_weight": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "enum": [100, 200, 300, 400, 500, 600, 700, 800, 900] }
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "parent_id", "kind", "box", "text", "style", "z_index"],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "parent_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$" }
          ]
        },
        "kind": {
          "type": "string",
          "enum": ["frame", "region", "text", "image", "control", "icon", "unknown"]
        },
        "box": { "$ref": "#/$defs/box" },
        "text": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 2000 }
          ]
        },
        "style": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/style" }]
        },
        "z_index": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    }
  }
}
