{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spe.local/schemas/protocol_graph.schema.json",
  "title": "ProtocolGraph",
  "description": "Immutable category protocol DAG projection for one domain and depth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "domain_id",
    "depth",
    "version",
    "nodes"
  ],
  "properties": {
    "protocol_id": { "type": "string", "minLength": 1 },
    "domain_id": { "type": "string", "minLength": 1 },
    "depth": {
      "type": "string",
      "enum": ["QUICK", "STANDARD", "DEEP", "CRITICAL"]
    },
    "version": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/protocol_node" }
    }
  },
  "$defs": {
    "protocol_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "stage",
        "title",
        "instruction",
        "required_at_depth",
        "prerequisites",
        "evidence_required",
        "tool_class",
        "exit_condition",
        "failure_behavior",
        "merge_key"
      ],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "stage": {
          "type": "string",
          "enum": [
            "MISSION",
            "UNDERSTAND",
            "GROUND",
            "EXECUTE",
            "VERIFY",
            "CHALLENGE",
            "DELIVER"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string" },
        "required_at_depth": {
          "type": "string",
          "enum": ["QUICK", "STANDARD", "DEEP", "CRITICAL"]
        },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_required": { "type": "boolean" },
        "tool_class": {
          "type": ["string", "null"]
        },
        "exit_condition": { "type": "string" },
        "failure_behavior": { "type": "string", "minLength": 1 },
        "merge_key": { "type": "string", "minLength": 1 }
      }
    }
  }
}
