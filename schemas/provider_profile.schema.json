{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spe.local/schemas/provider_profile.schema.json",
  "title": "ProviderProfileRegistry",
  "description": "Versioned provider capability profiles (distinct from domain grounding profiles).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "registry_version",
    "profiles"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "provider_profiles"
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider_profile" }
    }
  },
  "$defs": {
    "provider_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "provider",
        "profile_version",
        "effective_from",
        "capabilities",
        "privacy_behavior",
        "local_or_external",
        "requires_network",
        "requires_credentials",
        "authority_capabilities",
        "known_limitations"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": ["string", "null"]
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": ["string", "null"]
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "privacy_behavior": {
          "type": "object",
          "additionalProperties": true
        },
        "local_or_external": {
          "type": "string",
          "enum": ["local", "external"]
        },
        "requires_network": {
          "type": "boolean"
        },
        "requires_credentials": {
          "type": "boolean"
        },
        "pricing_metadata_if_known": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "authority_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Must not mint authority. Empty or read-only flags only."
        },
        "known_limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
